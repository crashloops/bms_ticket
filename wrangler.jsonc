{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bms-ticket-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
